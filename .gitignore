# Private project documents (the proposal, the instrument validation
# form) and old preview screenshots. Kept on the proponent's computer;
# the repository is public and published, so they must not be pushed.
docs-private/
# Nothing of these kinds is ever meant to be in the public repository.
*.pdf
*.docx

# Admin-only tools — must NEVER be pushed to a public repo.
# These are meant to run locally on your own machine only.
create_accounts.js

# Common places a secret key might accidentally end up.
.env
.env.local
*.secret
secret_key.txt

# Test tooling dependencies. _dev/ itself IS tracked (and not published,
# since Jekyll skips folders that start with an underscore); only the
# installed packages are not.
node_modules/
package-lock.json

# Previews and screenshots produced while working with an AI assistant.
# Never loaded by the game; the repository is public, so they stay local.
Claude outputs/

# Claude Code settings for this computer (the preview server it
# starts, permissions). Machine-local, so not part of the repository.
.claude/
